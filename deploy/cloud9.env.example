# Copy to /etc/cloud9/cloud9.env and make it readable by root only:
#   sudo install -d -m 755 /etc/cloud9
#   sudo install -m 600 deploy/cloud9.env.example /etc/cloud9/cloud9.env
# systemd reads it as root before starting Cloud9; Cloud9 removes C9_AUTH
# from the environment of the terminals and processes it starts.

# Login for the IDE (the password may contain ":")
C9_AUTH=username:a-long-random-password

# Public hostname of the app you run from the IDE (see apache2/cloud9-app.conf)
C9_HOSTNAME=app.example.com
