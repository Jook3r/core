{
    "script": [
        "if [ \"$debug\" == true ]; then ",
        "    if [ -d ~/.c9/debugpy/debugpy ]; then",
        "        debugpy=\"$HOME/.c9/debugpy/debugpy\"",
        "    elif python3 -c 'import debugpy' 2>/dev/null; then",
        "        debugpy='-m debugpy'",
        "    else",
        "        echo 'The Python debugger (debugpy) is not set up: run scripts/install-sdk.sh in the Cloud9 directory, or pip install debugpy' >&2",
        "        exit 1",
        "    fi",
        "    PYDEVD_DISABLE_FILE_VALIDATION=1 python3 $debugpy --listen 127.0.0.1:15471 --wait-for-client \"$file\" $args",
        "else",
        "    python3 \"$file\" $args",
        "fi"
    ],
    "debugport": 15471,
    "$debugDefaultState": false,
    "debugger": "dap",
    "dap": {
        "adapter": "debugpy",
        "arguments": { "justMyCode": true }
    },
    "selector": "^.*\\.(python|py)$",
    "env": {
        "PYTHONPATH": "$python_path"
    }
}
